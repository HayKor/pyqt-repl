# stage3.repl -- every stage 1-3 command in its successful mode, then one
# error at the end (the emulator aborts on the first failing command, so
# the error demos live in separate stage3_err_*.repl scripts instead).
# Run with --vfs vfs/deep.xml and HOME=/home/user (see scripts/vfs_deep.sh):
# real ls/cd arrived in stage 4, so this now exercises them for real
# instead of printing stub args.

ls -l $HOME
cd "${HOME}/docs"   # trailing comment after a real command
cd ..
ls -la
vfs-info
vfs-info extra
